# Docker Compose settings (docker-compose.yml). Copy to .env and fill in the blanks.
# Never commit .env. Generate the secrets with:
#   openssl rand -hex 24        POSTGRES_PASSWORD, REDIS_PASSWORD (URL-safe)
#   openssl rand -base64 48     APP_SECRET
#   openssl rand -base64 32     DATA_ENCRYPTION_KEY (must decode to exactly 32 bytes)
# Losing DATA_ENCRYPTION_KEY makes stored provider credentials unreadable: keep it in a secret store.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_SECRET=
DATA_ENCRYPTION_KEY=

# Public origin of the app. Plivo and Meta send webhooks to <PUBLIC_BASE_URL>/api/webhooks/...,
# so real providers need a public https URL. Plain http is accepted only for localhost.
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080

# Caddy: ":80" serves plain HTTP for any host name; a domain name (crm.example.com) turns on
# automatic HTTPS, which needs HTTP_PORT=80 and HTTPS_PORT=443 and DNS pointing at this host.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Number of reverse proxies in front of the API (Caddy = 1; Caddy behind an ALB = 2).
TRUST_PROXY=1

# Simulated providers for evaluation. Calls and messages are labelled SIMULATED and never reach
# real phones. Set all three to false in production.
TELEPHONY_DEFAULT_PROVIDER=mock
ALLOW_MOCK_PROVIDER=true
ALLOW_MOCK_CONTROLS=true
WHATSAPP_ALLOW_MOCK=true
# Simulated ring/talk timing multiplier (1 = realistic; smaller is faster).
MOCK_TIME_SCALE=1

# Optional platform-owned Plivo account (set TELEPHONY_DEFAULT_PROVIDER=plivo to use it).
# Organisations can instead store their own credentials under Integrations (encrypted at rest).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=

# Transactional email (invitations, password resets), e.g. smtps://user:pass@smtp.example.com:465.
# Without SMTP, invitation links are shown to the inviting admin and other email is only recorded
# in the email_outbox table, never sent.
SMTP_URL=
MAIL_FROM=Calling CRM <no-reply@example.com>

# Recordings and import files. local = Docker volume; s3 = S3 or an S3-compatible store.
# On AWS prefer an instance/task role and leave the access keys empty.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=info
ENABLE_API_DOCS=false
NEXT_PUBLIC_PRODUCT_NAME=Calling CRM
# Image tag for calling-crm/api and calling-crm/web.
CRM_IMAGE_TAG=local
