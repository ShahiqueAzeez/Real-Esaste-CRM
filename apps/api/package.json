{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Calling CRM API and background worker (NestJS modular monolith).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "db:example-plans": "tsx src/scripts/example-plans.ts",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "jest -c jest.unit.config.js",
    "test:int": "jest -c jest.int.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@crm/shared": "0.1.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "plivo": "4.79.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15"
  }
}
