# API and worker settings for local development (npm run dev). Copy to apps/api/.env.
# Never commit .env. Every variable is validated at startup (src/config/config.ts).
NODE_ENV=development
PORT=4000

# Postgres and Redis from `docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis`
# (use the passwords from the root .env), or any local installation.
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm?schema=public
REDIS_URL=redis://:change-me@localhost:6379/0

# openssl rand -base64 48
APP_SECRET=
# openssl rand -base64 32   (exactly 32 bytes once decoded)
DATA_ENCRYPTION_KEY=

# Where Plivo/Meta send webhooks. For real provider testing this must be a public https URL
# (for example a tunnel to localhost:3000); Plivo rejects localhost callback URLs.
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Simulated telephony and WhatsApp (labelled SIMULATED in the UI).
TELEPHONY_DEFAULT_PROVIDER=mock
ALLOW_MOCK_PROVIDER=true
ALLOW_MOCK_CONTROLS=true
WHATSAPP_ALLOW_MOCK=true
# 1 = realistic ring/talk timings; smaller values speed simulated calls up.
MOCK_TIME_SCALE=1

# Optional platform-owned Plivo account.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=

SMTP_URL=
MAIL_FROM=Calling CRM <no-reply@localhost>

STORAGE_DRIVER=local
STORAGE_DIR=./storage

LOG_LEVEL=debug
LOG_PRETTY=true
ENABLE_API_DOCS=true
